rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function marahActive(uid) {
      return get(/databases/$(db)/documents/marahs/$(uid)).data.active == true;
    }

    // المشرفين: يُضافون يدوياً من لوحة Firebase
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // المرحان: كل مالك له مراح واحد برقم حسابه
    match /marahs/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.active == false
        && request.resource.data.verified == false
        && request.resource.data.awards == 0;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['active', 'verified', 'awards', 'activeUntil']));
      allow delete: if isAdmin();
    }

    // الحلال المعروض
    match /items/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.marahId == request.auth.uid
        && marahActive(request.auth.uid);
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.marahId == request.auth.uid);
    }

    // طلبات الشراء
    match /requests/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // إيصالات التحويل
    match /receipts/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
